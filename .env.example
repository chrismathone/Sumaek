# ── Supabase ────────────────────────────────────────────────
# Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 — 클라이언트 번들·로그에 노출 금지
SUPABASE_SERVICE_ROLE_KEY=

# ── PostgreSQL ──────────────────────────────────────────────
#
# 마이그레이션·워커·반입 CLI가 쓰는 연결.
#
# **Direct 연결(db.<ref>.supabase.co)을 쓰지 말 것.** 이 프로젝트에서는 그
# 호스트가 DNS로 풀리지 않는다. Settings → Database → Connection string 에서
# **Session pooler**(포트 5432, 세션 모드 = prepared statement 지원)를 복사해
# 여기에 넣는다. 형태는 아래와 같다:
#
#   postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
#
DATABASE_URL=
# 웹 요청 경로용 Transaction pooler (포트 6543). 선택.
DATABASE_POOLER_URL=

# ── AI 공급자 (목 어댑터 기본) ──────────────────────────────
# provider: mock | anthropic
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

# ── 워커 ────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
# 아래는 기본값이 있어 비워 둬도 된다 — 바꿀 때만 채운다
# WORKER_HEARTBEAT_SECONDS=
# WORKER_SHUTDOWN_GRACE_MS=
# OUTBOX_MAX_ATTEMPTS=

# ── 데모·시험 계정 ──────────────────────────────────────────
# `pnpm --filter @su-maek/db demo-account`가 만드는 로그인 계정.
# db:seed는 users 테이블 행만 넣고 **인증 계정은 만들지 않는다** —
# 브라우저로 로그인하려면 이 스크립트를 따로 돌려야 한다.
# 비워 두면 코드의 기본값을 쓴다(packages/db/src/seed/demo-account.ts 참조).
# DEMO_TEACHER_EMAIL=
# DEMO_TEACHER_PASSWORD=
# DEMO_STUDENT_PASSWORD=

# ── NEIS 나이스 교육정보 개방 포털 ──────────────────────────
# 학교 학사일정(시험 기간·휴업일·방학) 수신에 쓴다 (설정 → 외부 명단 연동).
# 발급: https://open.neis.go.kr → 회원가입 → 인증키 신청 (즉시 발급, 무료).
# 비워 두면 키 없는 샘플 호출로 동작한다 — **호출당 5건만** 내려오므로
# 학교 검색은 되지만 학사일정 가져오기는 부분 결과가 된다 (화면에 경고 표시).
# 키를 채운 뒤 `pnpm env:sync`를 돌리면 Vercel 프로덕션 env에도 반영된다.
NEIS_API_KEY=

# ── 공공데이터포털 (data.go.kr) ─────────────────────────────
# 발급: https://www.data.go.kr → 로그인 → 원하는 API 활용신청 → 마이페이지의
# 일반 인증키. **Decoding 키를 넣을 것** — Encoding 키(%2B·%3D 포함)를 넣으면
# 호출 코드가 URL 인코딩을 한 번 더 해서 SERVICE_KEY_IS_NOT_REGISTERED가 난다.
# 승인 직후에는 반영까지 수 시간 걸릴 수 있다. 채운 뒤 `pnpm env:sync`.
DATA_GO_KR_API_KEY=

# ── 검증 도구 (선택) ────────────────────────────────────────
# RECOVERY_DATABASE_URL=   # verify:recovery 를 다른 DB에 돌릴 때
# E2E_BASE_URL=            # e2e를 배포본에 돌릴 때
