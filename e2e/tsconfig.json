{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // DOM 은 Playwright `page.evaluate`·`locator.evaluate` 콜백 때문에 필요하다 —
    // 그 함수들은 브라우저 안에서 실행되므로 HTMLInputElement 등을 참조한다.
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["tests", "playwright.config.ts"]
}
